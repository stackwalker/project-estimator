ESTIMATE_STORE=memory

# Anonymous abuse protection defaults.
TRUST_PROXY=false
ESTIMATE_BURST_LIMIT=20
ESTIMATE_BURST_WINDOW_SECONDS=60
ESTIMATE_DAILY_CREATE_LIMIT=25
ESTIMATE_QUOTA_WINDOW_HOURS=24
MONGODB_QUOTA_COLLECTION=estimate_quotas

# To use MongoDB Atlas, set ESTIMATE_STORE=mongodb and provide your Atlas URI.
# ESTIMATE_STORE=mongodb
# MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/?retryWrites=true&w=majority
# MONGODB_DB=estimator
# MONGODB_COLLECTION=estimates
